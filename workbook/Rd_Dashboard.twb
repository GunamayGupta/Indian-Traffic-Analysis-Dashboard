    <worksheet name='KPI - YoY Change'>
      <table>
        <view>
          <datasources>
            <datasource caption='clean_india_accidents (Multiple Connections)' name='federated.1epn9tz0iuw69x17n47ce1k6h310' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected_Year_Parameter' datatype='integer' default-format='*' name='[Parameter 0907399613624324]' param-domain-type='list' role='measure' type='quantitative' value='2019'>
              <calculation class='tableau' formula='2019' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1epn9tz0iuw69x17n47ce1k6h310'>
            <column caption='Accident(Selected_Year)' datatype='integer' name='[Calculation_0907399620063242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// 1. Accidents - Selected Year&#13;&#10;{FIXED : COUNT(IF INT([year]) = [Parameters].[Parameter 0907399613624324] THEN 1 END)}' />
            </column>
            <column caption='Accident(Previous_Year)' datatype='integer' name='[Calculation_0907399620521995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// 2. Accidents - Previous Year&#13;&#10;{FIXED : COUNT(IF INT([year]) = [Parameters].[Parameter 0907399613624324] - 1 THEN 1 END)}' />
            </column>
            <column caption='YoY_Accident_Change' datatype='real' name='[Calculation_0907399620755468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// 3. YoY Accident Change  (guards against divide-by-zero / missing prior year)&#13;&#10;IIF(&#13;&#10;    ISNULL([Calculation_0907399620521995]) OR [Calculation_0907399620521995] = 0,&#13;&#10;    NULL,&#13;&#10;    ([Calculation_0907399620063242] - [Calculation_0907399620521995]) / [Calculation_0907399620521995]&#13;&#10;)' />
            </column>
            <column caption='Accident Severity' datatype='string' name='[accident_severity]' role='dimension' type='nominal' />
            <column-instance column='[accident_severity]' derivation='Count' name='[cnt:accident_severity:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0907399620755468]' derivation='Sum' name='[sum:Calculation_0907399620755468:qk]' pivot='key' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='font-size' field='[federated.1epn9tz0iuw69x17n47ce1k6h310].[cnt:accident_severity:qk]' value='36' />
          </style-rule>

            <contains-null>true</contains-null>
            <collation flag='1' name='LEN_RIN_S2' />
            <attributes>
              <attribute datatype='string' name='DebugRemoteType'>&quot;WSTR&quot;</attribute>
            </attributes>
            <object-id>[clean!india!accidents_05FCCE99F8FA4B708509EDBF4A172FA9]</object-id>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column caption='Severity_Rank' datatype='integer' name='[Calculation_0907399612125184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [accident_severity] = &quot;Fatal&quot; THEN 3 ELSEIF [accident_severity] = &quot;Serious&quot; THEN 2 ELSE 1 END' />
      </column>
      <column caption='Is_Two_Wheeler_(Label)' datatype='string' name='[Calculation_0907399612424193]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [vehicle_type_involved] = &quot;Two-Wheeler&quot; OR CONTAINS(LOWER([vehicle_type_involved]), &quot;bike&quot;) OR CONTAINS(LOWER([vehicle_type_involved]), &quot;scooter&quot;) THEN &quot;Two-Wheeler&quot; ELSE &quot;Other Vehicle&quot; END' />
      </column>
      <column caption='Monsoon Flag' datatype='string' name='[Calculation_0907399612825602]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_monsoon_month] = 1 THEN &quot;Monsoon (Jun–Sep)&quot; ELSE &quot;Non-Monsoon&quot; END' />
      </column>
      <column caption='Fatality_Rate' datatype='real' name='[Calculation_0907399613317123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [accident_severity] = &quot;Fatal&quot; THEN 1 ELSE 0 END) / COUNT([accident_severity])' />
      </column>
      <column caption='Alcohol_Flag' datatype='string' name='[Calculation_0907399614881798]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [alcohol_involvement] = &quot;Yes&quot; THEN &quot;Alcohol Involved&quot; ELSE &quot;No Alcohol Involvement&quot; END' />
      </column>
      <column caption='High_Speed_Flag' datatype='string' name='[Calculation_0907399615254535]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [speed_limit_kmh] &gt; {FIXED [road_type] : PERCENTILE([speed_limit_kmh], 0.75)} THEN &quot;Above 75th pct for Road Type&quot; ELSE &quot;Normal&quot; END' />
      </column>
      <column caption='Two_Wheeler_Share' datatype='real' name='[Calculation_0907399617359880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_two_wheeler] = 1 THEN 1 ELSE 0 END) / COUNT([vehicle_type_involved])' />
      </column>
      <column caption='Accident(Selected_Year)' datatype='integer' name='[Calculation_0907399620063242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// 1. Accidents - Selected Year&#13;&#10;{FIXED : COUNT(IF INT([year]) = [Parameters].[Parameter 0907399613624324] THEN 1 END)}' />
      </column>
      <column caption='Accident(Previous_Year)' datatype='integer' name='[Calculation_0907399620521995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// 2. Accidents - Previous Year&#13;&#10;{FIXED : COUNT(IF INT([year]) = [Parameters].[Parameter 0907399613624324] - 1 THEN 1 END)}' />
      </column>
      <column caption='YoY_Accident_Change' datatype='real' name='[Calculation_0907399620755468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// 3. YoY Accident Change  (guards against divide-by-zero / missing prior year)&#13;&#10;IIF(&#13;&#10;    ISNULL([Calculation_0907399620521995]) OR [Calculation_0907399620521995] = 0,&#13;&#10;    NULL,&#13;&#10;    ([Calculation_0907399620063242] - [Calculation_0907399620521995]) / [Calculation_0907399620521995]&#13;&#10;)' />
      </column>
      <column caption='clean_india_accidents' datatype='table' name='[__tableau_internal_object_id__].[clean!india!accidents_05FCCE99F8FA4B708509EDBF4A172FA9]' role='measure' type='quantitative' />
